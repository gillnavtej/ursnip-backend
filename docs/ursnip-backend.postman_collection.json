{
	"info": {
		"_postman_id": "ursnip-backend-collection",
		"name": "Ursnip Backend API",
		"description": "Complete API collection for the ursnip-backend Rust/Axum server. Base URL: http://localhost:8080. Authenticated endpoints require Bearer token in Authorization header.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "accessToken", "value": "" },
		{ "key": "refreshToken", "value": "" },
		{ "key": "userId", "value": "" },
		{ "key": "workspaceId", "value": "" },
		{ "key": "sessionId", "value": "" },
		{ "key": "snippetId", "value": "" },
		{ "key": "folderId", "value": "" },
		{ "key": "subscriptionId", "value": "" },
		{ "key": "teamWorkspaceId", "value": "" },
		{ "key": "inviteCode", "value": "" },
		{ "key": "adminInviteToken", "value": "" }
	],
	"auth": {
		"type": "bearer",
		"bearer": [{ "key": "token", "value": "{{accessToken}}" }]
	},
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
						"description": "Liveness check. Verifies Postgres reachability via SELECT 1."
					}
				},
				{
					"name": "Readiness Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/ready", "host": ["{{baseUrl}}"], "path": ["ready"] },
						"description": "Readiness check. Verifies DB, scheduler, and email subsystems are initialized."
					}
				}
			]
		},
		{
			"name": "Auth - Public",
			"item": [
				{
					"name": "Register",
					"event": [{ "listen": "test", "script": { "exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('accessToken', jsonData.access_token);", "pm.collectionVariables.set('refreshToken', jsonData.refresh_token);", "pm.collectionVariables.set('userId', jsonData.user.id);", "pm.collectionVariables.set('workspaceId', jsonData.user.workspace_id);"] } }],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\",\n  \"client_type\": \"native\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\"\n}" },
						"url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
						"description": "Register a new user. Returns access_token, refresh_token, and user info. Creates individual workspace + free subscription."
					}
				},
				{
					"name": "Login",
					"event": [{ "listen": "test", "script": { "exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('accessToken', jsonData.access_token);", "pm.collectionVariables.set('refreshToken', jsonData.refresh_token);", "pm.collectionVariables.set('userId', jsonData.user.id);", "pm.collectionVariables.set('workspaceId', jsonData.user.workspace_id);"] } }],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\",\n  \"client_type\": \"native\"\n}" },
						"url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
						"description": "Authenticate with email/password. Returns token pair. Enforces brute-force protection (5 failures = 15min lockout)."
					}
				},
				{
					"name": "Refresh Token",
					"event": [{ "listen": "test", "script": { "exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('accessToken', jsonData.access_token);", "pm.collectionVariables.set('refreshToken', jsonData.refresh_token);"] } }],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\",\n  \"client_type\": \"native\"\n}" },
						"url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
						"description": "Rotate refresh token. Old token is invalidated (token rotation). Reuse of old token triggers security lockout."
					}
				},
				{
					"name": "Forgot Password",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"email\": \"testuser@example.com\"\n}" },
						"url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
						"description": "Request password reset email. Always returns 200 to prevent email enumeration."
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"token\": \"reset-token-from-email\",\n  \"password\": \"newpassword123\"\n}" },
						"url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] },
						"description": "Reset password using token from email. Revokes all refresh tokens. Token expires after 30 minutes."
					}
				},
				{
					"name": "Verify Email Change",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/auth/verify-email-change?token=verification-token", "host": ["{{baseUrl}}"], "path": ["auth", "verify-email-change"], "query": [{ "key": "token", "value": "verification-token" }] },
						"description": "Verify an email change token (from verification email link). Updates user email on success."
					}
				},
				{
					"name": "Register via Admin Invite",
					"event": [{ "listen": "test", "script": { "exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('accessToken', jsonData.access_token);", "pm.collectionVariables.set('refreshToken', jsonData.refresh_token);"] } }],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"token\": \"{{adminInviteToken}}\",\n  \"password\": \"adminpass123\",\n  \"first_name\": \"Admin\",\n  \"last_name\": \"User\",\n  \"client_type\": \"web\"\n}" },
						"url": { "raw": "{{baseUrl}}/auth/register-invite", "host": ["{{baseUrl}}"], "path": ["auth", "register-invite"] },
						"description": "Register a new admin user via a valid admin invite token. Creates user with role=admin."
					}
				},
				{
					"name": "OAuth Authorize (Google)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/auth/oauth/google/authorize?client=web", "host": ["{{baseUrl}}"], "path": ["auth", "oauth", "google", "authorize"], "query": [{ "key": "client", "value": "web" }] },
						"description": "Redirect to Google OAuth authorization page. Returns 302 redirect."
					}
				},
				{
					"name": "OAuth Authorize (GitHub)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/auth/oauth/github/authorize?client=native", "host": ["{{baseUrl}}"], "path": ["auth", "oauth", "github", "authorize"], "query": [{ "key": "client", "value": "native" }] },
						"description": "Redirect to GitHub OAuth authorization page. Returns 302 redirect."
					}
				}
			]
		},
		{
			"name": "Auth - Protected",
			"item": [
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}" },
						"url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
						"description": "Invalidate the current refresh token. Returns 204 No Content."
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] },
						"description": "Get the authenticated user's full profile."
					}
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"timezone\": \"America/New_York\",\n  \"language\": \"en\",\n  \"country_code\": \"US\",\n  \"phone\": \"+1234567890\"\n}" },
						"url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] },
						"description": "Update user profile fields. Only provided fields are updated."
					}
				},
				{
					"name": "Change Email",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"new_email\": \"newemail@example.com\"\n}" },
						"url": { "raw": "{{baseUrl}}/auth/change-email", "host": ["{{baseUrl}}"], "path": ["auth", "change-email"] },
						"description": "Initiate email change. Sends verification link to new address. Token expires in 24h."
					}
				},
				{
					"name": "Change Password",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"current_password\": \"password123\",\n  \"new_password\": \"newpassword456\"\n}" },
						"url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] },
						"description": "Change password. Requires current password. Revokes ALL refresh tokens after success."
					}
				},
				{
					"name": "Delete Account",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": { "raw": "{{baseUrl}}/auth/account", "host": ["{{baseUrl}}"], "path": ["auth", "account"] },
						"description": "Soft-delete account. Recoverable via login within 30 days. Fails if user owns team workspaces."
					}
				},
				{
					"name": "List Sessions",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/auth/sessions", "host": ["{{baseUrl}}"], "path": ["auth", "sessions"] },
						"description": "List all active sessions (non-revoked, non-expired refresh tokens) for the authenticated user."
					}
				},
				{
					"name": "Revoke Session",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": { "raw": "{{baseUrl}}/auth/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["auth", "sessions", "{{sessionId}}"] },
						"description": "Revoke a specific session by its ID. Returns 204 No Content."
					}
				}
			]
		},
		{
			"name": "Sync - Snippets",
			"description": "All sync endpoints require client_type=native in the JWT.",
			"item": [
				{
					"name": "Create Snippet",
					"event": [{ "listen": "test", "script": { "exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('snippetId', jsonData.id);"] } }],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"workspace_id\": \"{{workspaceId}}\",\n  \"trigger\": \"hello\",\n  \"content\": \"Hello, world!\",\n  \"snippet_type\": \"text\",\n  \"folder_id\": null\n}" },
						"url": { "raw": "{{baseUrl}}/sync/snippets", "host": ["{{baseUrl}}"], "path": ["sync", "snippets"] },
						"description": "Create a new snippet. Free tier: max 10 snippets, max 2000 chars content. Trigger must be unique within workspace."
					}
				},
				{
					"name": "Update Snippet",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"trigger\": \"updated-trigger\",\n  \"content\": \"Updated content here\",\n  \"snippet_type\": \"text\"\n}" },
						"url": { "raw": "{{baseUrl}}/sync/snippets/{{snippetId}}", "host": ["{{baseUrl}}"], "path": ["sync", "snippets", "{{snippetId}}"] },
						"description": "Update snippet fields. All fields optional. Increments version."
					}
				},
				{
					"name": "Delete Snippet",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": { "raw": "{{baseUrl}}/sync/snippets/{{snippetId}}", "host": ["{{baseUrl}}"], "path": ["sync", "snippets", "{{snippetId}}"] },
						"description": "Soft-delete a snippet. Returns 204 No Content."
					}
				},
				{
					"name": "Batch Operations",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"workspace_id\": \"{{workspaceId}}\",\n  \"operations\": [\n    {\n      \"type\": \"create_snippet\",\n      \"workspace_id\": \"{{workspaceId}}\",\n      \"trigger\": \"batch1\",\n      \"content\": \"Batch created snippet\",\n      \"snippet_type\": \"text\"\n    },\n    {\n      \"type\": \"update_snippet\",\n      \"id\": \"{{snippetId}}\",\n      \"content\": \"Batch updated content\"\n    },\n    {\n      \"type\": \"delete_snippet\",\n      \"id\": \"{{snippetId}}\"\n    }\n  ]\n}" },
						"url": { "raw": "{{baseUrl}}/sync/snippets/batch", "host": ["{{baseUrl}}"], "path": ["sync", "snippets", "batch"] },
						"description": "Execute multiple snippet operations atomically. Max 100 items per batch. Rolls back entirely on any error."
					}
				}
			]
		},
		{
			"name": "Sync - Folders",
			"item": [
				{
					"name": "Create Folder",
					"event": [{ "listen": "test", "script": { "exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('folderId', jsonData.id);"] } }],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"workspace_id\": \"{{workspaceId}}\",\n  \"name\": \"My Folder\"\n}" },
						"url": { "raw": "{{baseUrl}}/sync/folders", "host": ["{{baseUrl}}"], "path": ["sync", "folders"] },
						"description": "Create a new folder. Free tier: max 3 folders."
					}
				},
				{
					"name": "Update Folder",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"name\": \"Renamed Folder\"\n}" },
						"url": { "raw": "{{baseUrl}}/sync/folders/{{folderId}}", "host": ["{{baseUrl}}"], "path": ["sync", "folders", "{{folderId}}"] },
						"description": "Update folder name. Returns updated folder with incremented version."
					}
				},
				{
					"name": "Delete Folder",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": { "raw": "{{baseUrl}}/sync/folders/{{folderId}}", "host": ["{{baseUrl}}"], "path": ["sync", "folders", "{{folderId}}"] },
						"description": "Soft-delete a folder. Returns 204 No Content."
					}
				}
			]
		},
		{
			"name": "Sync - Snapshot & Deltas",
			"item": [
				{
					"name": "Get Snapshot",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/sync/snapshot?workspace_id={{workspaceId}}", "host": ["{{baseUrl}}"], "path": ["sync", "snapshot"], "query": [{ "key": "workspace_id", "value": "{{workspaceId}}" }] },
						"description": "Full workspace snapshot with all active snippets and folders plus current version number."
					}
				},
				{
					"name": "Get Deltas",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/sync/deltas?workspace_id={{workspaceId}}&since_version=0&limit=500", "host": ["{{baseUrl}}"], "path": ["sync", "deltas"], "query": [{ "key": "workspace_id", "value": "{{workspaceId}}" }, { "key": "since_version", "value": "0" }, { "key": "limit", "value": "500" }] },
						"description": "Delta polling for incremental sync. Max limit=1000. Deltas retained for 30 days."
					}
				},
				{
					"name": "WebSocket Upgrade",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/sync/ws", "host": ["{{baseUrl}}"], "path": ["sync", "ws"] },
						"description": "WebSocket upgrade endpoint for real-time push notifications. Currently returns 501 (placeholder)."
					}
				}
			]
		},
		{
			"name": "AI",
			"item": [
				{
					"name": "AI Expand",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"trigger\": \"greeting\",\n  \"system_prompt\": \"Generate a professional greeting email\",\n  \"context\": \"For a new client meeting\"\n}" },
						"url": { "raw": "{{baseUrl}}/ai/expand", "host": ["{{baseUrl}}"], "path": ["ai", "expand"] },
						"description": "Expand a trigger via AI provider. Requires native client. Quota: free=50/day, pro/teams=1000/day. Max trigger=500 chars, system_prompt=10KB, context=50KB."
					}
				}
			]
		},
		{
			"name": "Subscriptions",
			"description": "All subscription endpoints require client_type=web in the JWT.",
			"item": [
				{
					"name": "Upgrade Subscription",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"workspace_id\": \"{{workspaceId}}\"\n}" },
						"url": { "raw": "{{baseUrl}}/subscriptions/upgrade", "host": ["{{baseUrl}}"], "path": ["subscriptions", "upgrade"] },
						"description": "Initiate upgrade from free to pro tier. Sets status to pending_payment."
					}
				},
				{
					"name": "Checkout",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"workspace_id\": \"{{workspaceId}}\",\n  \"tier\": \"pro\",\n  \"billing_cycle_months\": 12,\n  \"coupon_code\": null,\n  \"discount_id\": null,\n  \"country_code\": \"US\",\n  \"success_url\": \"http://localhost:3000/billing/success\",\n  \"cancel_url\": \"http://localhost:3000/billing/cancel\"\n}" },
						"url": { "raw": "{{baseUrl}}/subscriptions/checkout", "host": ["{{baseUrl}}"], "path": ["subscriptions", "checkout"] },
						"description": "Compute invoice and get checkout URL. Validates coupons/discounts, computes tax, returns Paddle checkout link."
					}
				},
				{
					"name": "Get Current Subscription",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/subscriptions/current?workspace_id={{workspaceId}}", "host": ["{{baseUrl}}"], "path": ["subscriptions", "current"], "query": [{ "key": "workspace_id", "value": "{{workspaceId}}" }] },
						"description": "Get the current subscription for a workspace including tier, status, and period dates."
					}
				}
			]
		},
		{
			"name": "Teams",
			"description": "All team endpoints require client_type=web in the JWT.",
			"item": [
				{
					"name": "Create Team",
					"event": [{ "listen": "test", "script": { "exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('teamWorkspaceId', jsonData.id);"] } }],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"name\": \"My Team Workspace\"\n}" },
						"url": { "raw": "{{baseUrl}}/teams", "host": ["{{baseUrl}}"], "path": ["teams"] },
						"description": "Create a new team workspace. The authenticated user becomes the owner."
					}
				},
				{
					"name": "Get Team",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/teams/{{teamWorkspaceId}}", "host": ["{{baseUrl}}"], "path": ["teams", "{{teamWorkspaceId}}"] },
						"description": "Get team workspace details including name, type, and owner."
					}
				},
				{
					"name": "Create Invite",
					"event": [{ "listen": "test", "script": { "exec": ["var jsonData = pm.response.json();", "if(jsonData.invite_code) pm.collectionVariables.set('inviteCode', jsonData.invite_code);"] } }],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"max_uses\": 5,\n  \"expires_in_days\": 7\n}" },
						"url": { "raw": "{{baseUrl}}/teams/{{teamWorkspaceId}}/invites", "host": ["{{baseUrl}}"], "path": ["teams", "{{teamWorkspaceId}}", "invites"] },
						"description": "Create an invite link for the team workspace. Only the owner can create invites."
					}
				},
				{
					"name": "Join via Invite",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"invite_code\": \"{{inviteCode}}\"\n}" },
						"url": { "raw": "{{baseUrl}}/teams/{{teamWorkspaceId}}/join", "host": ["{{baseUrl}}"], "path": ["teams", "{{teamWorkspaceId}}", "join"] },
						"description": "Join a team workspace using an invite code. Max 3 members per team."
					}
				},
				{
					"name": "List Members",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/teams/{{teamWorkspaceId}}/members", "host": ["{{baseUrl}}"], "path": ["teams", "{{teamWorkspaceId}}", "members"] },
						"description": "List all members of a team workspace with their roles."
					}
				},
				{
					"name": "Remove Member",
					"request": {
						"method": "DELETE",
						"header": [],
